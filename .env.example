# ============================================================
# Local AiDP POC — environment configuration
# ALL CREDENTIALS BELOW ARE FOR LOCAL DEVELOPMENT ONLY.
# Never reuse these values outside this local POC.
# ============================================================

# ---- Timezone (pinned; night_transaction_flag is evaluated against this) ----
APP_TIMEZONE=Asia/Kolkata

# ---- PostgreSQL (demo database) ----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aidp
POSTGRES_USER=aidp
POSTGRES_PASSWORD=aidp_local_only

# ---- PostgreSQL (isolated test database, fix H4) ----
POSTGRES_TEST_DB=aidp_test

# ---- MinIO (S3-compatible object storage) ----
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_CONSOLE_ENDPOINT=127.0.0.1:9001
MINIO_ACCESS_KEY=aidpadmin
MINIO_SECRET_KEY=aidpadmin123_local_only
MINIO_SECURE=false

# ---- Redpanda (Kafka-compatible streaming) ----
REDPANDA_BROKERS=127.0.0.1:9092
REDPANDA_TOPIC_TRANSACTIONS=transactions
REDPANDA_TOPIC_FRAUD_DECISIONS=fraud-decisions
REDPANDA_TOPIC_DLQ=dead-letter-transactions
# Isolated test topic (fix H4)
REDPANDA_TOPIC_TEST=transactions-test

# ---- MLflow (backend store: Postgres DB "mlflow"; artifacts: MinIO bucket) ----
# Port 5001 on the host, not 5000, to avoid the macOS AirPlay Receiver conflict (fix C4)
MLFLOW_TRACKING_URI=http://127.0.0.1:5001
MLFLOW_BACKEND_DB=mlflow
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts
MLFLOW_MODEL_NAME=fraud-detection-model

# ---- FastAPI ----
API_HOST=127.0.0.1
API_PORT=8000

# ---- Streamlit ----
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8501

# ---- Redpanda Console ----
REDPANDA_CONSOLE_PORT=8080

# ---- Synthetic data generation defaults ----
GEN_CUSTOMERS=10000
# Default lowered from 250,000 to 50,000 to stay comfortable on 16GB RAM laptops (fix H5)
GEN_HISTORICAL_TRANSACTIONS=50000
GEN_FRAUD_RATIO=0.03
GEN_RANDOM_SEED=42
