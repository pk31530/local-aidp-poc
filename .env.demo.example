# ============================================================
# Local AiDP POC -- ISOLATED Debit Card demonstration environment
#
# This file configures a SEPARATE demonstration stack. It never overwrites
# .env, is never read by the normal stack, and contains NO credentials:
# POSTGRES_PASSWORD and MINIO_SECRET_KEY are deliberately absent here and
# are generated locally, once, into the git-ignored .env.demo.local by
# scripts/demo_debit_card_full_lifecycle.sh.
#
# Isolation mechanism (derived from source, not guessed):
#   * src/common/config.py builds Settings with pydantic-settings, which
#     gives real process environment variables PRECEDENCE over .env. The
#     demo script exports the values below, so every CLI process resolves
#     Postgres/MinIO/MLflow to the isolated stack while .env is untouched.
#   * docker-compose.demo.yml is a SEPARATE compose project (aidp-demo)
#     with its own container names, network, volumes and host ports --
#     docker-compose.yml hardcodes container_name and most host ports, so
#     a second project of the same file is not possible.
#
# Usage (both files are passed to docker compose and sourced by the script):
#   docker compose -p aidp-demo -f docker-compose.demo.yml \
#     --env-file .env.demo.example --env-file .env.demo.local up -d
# ============================================================

# ---- Timezone (same pinned value as the shared stack) ----
APP_TIMEZONE=Asia/Kolkata

# ---- PostgreSQL (ISOLATED demo cluster) ----
# Host port 55432, NOT 5432: the shared aidp-postgres container owns 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=aidp_demo
POSTGRES_USER=aidp_demo
# POSTGRES_PASSWORD -- intentionally not stored here; see .env.demo.local.

# src/dashboard/data.py::_dashboard_database() reads settings.postgres_test_db,
# NOT settings.postgres_db. Pointing it at aidp_demo makes the dashboard show
# the demo database AND removes the only code path that could resolve to
# aidp_test. Nothing in this stack may ever resolve to `aidp` or `aidp_test`.
POSTGRES_TEST_DB=aidp_demo

# ---- MinIO (ISOLATED object storage; separate server + separate volume) ----
# Host ports 59000/59001, NOT 9000/9001.
MINIO_ENDPOINT=127.0.0.1:59000
MINIO_CONSOLE_ENDPOINT=127.0.0.1:59001
MINIO_ACCESS_KEY=aidpdemoadmin
MINIO_SECURE=false
# MINIO_SECRET_KEY -- intentionally not stored here; see .env.demo.local.

# Host-port bindings consumed by docker-compose.demo.yml. Kept as separate
# variables because MINIO_ENDPOINT above is a host:port STRING that compose
# cannot split.
DEMO_MINIO_API_PORT=59000
DEMO_MINIO_CONSOLE_PORT=59001
DEMO_MLFLOW_PORT=55001

# ---- MLflow (ISOLATED tracking server, backend store and registry) ----
# Host port 55001, NOT 5001. The backend store is the `mlflow` database of
# the ISOLATED demo Postgres cluster (a different server than the shared
# stack's), and artifacts land in the ISOLATED MinIO. The registered-model
# names are therefore identical strings in a completely separate registry.
MLFLOW_TRACKING_URI=http://127.0.0.1:55001
MLFLOW_BACKEND_DB=mlflow
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts
MLFLOW_MODEL_NAME=fraud-detection-model

# MLflow's own client/server S3 wiring. src/common/mlflow_setup.py uses
# os.environ.setdefault(), so an explicit export here always wins.
MLFLOW_S3_ENDPOINT_URL=http://127.0.0.1:59000
MLFLOW_S3_IGNORE_TLS=true

# ---- Redpanda ----
# The fraud-intelligence lifecycle (generate/train/evaluate/promote/score/
# labels) never touches Kafka, so the demo stack runs no broker at all.
# This points at a reserved, deliberately-unused port so that a stray
# streaming command fails fast instead of silently reaching the shared
# aidp-redpanda broker on 9092.
REDPANDA_BROKERS=127.0.0.1:59092
REDPANDA_TOPIC_TRANSACTIONS=demo-transactions
REDPANDA_TOPIC_FRAUD_DECISIONS=demo-fraud-decisions
REDPANDA_TOPIC_DLQ=demo-dead-letter-transactions
REDPANDA_TOPIC_TEST=demo-transactions-test

# ---- FastAPI / Streamlit (demo ports, so the shared stack's stay free) ----
API_HOST=127.0.0.1
API_PORT=58000
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=58501
REDPANDA_CONSOLE_PORT=58080

# ---- Synthetic data generation ----
# Deliberately IDENTICAL to .env.example. The demo's own seed (99) is passed
# explicitly as `--seed 99` on the generate command line and applies to the
# GENERATOR only. GEN_RANDOM_SEED is a different thing: it supplies
# ChannelTrainingRunConfig.random_seed (src/fraud_intel/config.py), i.e. the
# GBM/LR random_state -- a model parameter. It is left at the repository
# default so this demo changes no model parameter, weight or threshold.
GEN_CUSTOMERS=10000
GEN_HISTORICAL_TRANSACTIONS=50000
GEN_FRAUD_RATIO=0.03
GEN_RANDOM_SEED=42
